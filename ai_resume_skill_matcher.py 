
import re

SKILLS = {
    "Python": ["python"],
    "Java": ["java"],
    "SQL": ["sql", "mysql", "postgresql"],
    "Machine Learning": ["machine learning", "scikit-learn", "sklearn"],
    "Deep Learning": ["deep learning", "pytorch", "tensorflow"],
    "Data Analysis": ["data analysis", "pandas", "numpy"],
    "Web Development": ["html", "css", "javascript", "react"],
    "Git and GitHub": ["git", "github"],
    "Communication": ["communication", "teamwork"],
    "Problem Solving": ["problem solving", "data structures", "algorithms"]
}


def find_skills(text):
    text = text.lower()
    found = set()

    for skill, keywords in SKILLS.items():
        for keyword in keywords:
            pattern = r"(?<!\w)" + re.escape(keyword) + r"(?!\w)"
            if re.search(pattern, text):
                found.add(skill)
                break

    return found


def analyze_resume():
    print("=" * 35)
    print("     AI RESUME SKILL MATCHER")
    print("=" * 35)
    print("Enter resume and job description below.")

    resume = input("\nPaste resume text: ").strip()
    job = input("\nPaste job description: ").strip()

    if not resume or not job:
        print("\nError: Inputs cannot be empty.")
        return

    resume_skills = find_skills(resume)
    job_skills = find_skills(job)

    if not job_skills:
        print("\nNo supported skills found in job description.")
        print("Try Python, SQL, Java, or Machine Learning.")
        return

    matching = resume_skills & job_skills
    missing = job_skills - resume_skills
    score = len(matching) / len(job_skills) * 100

    print("\n" + "=" * 35)
    print("           MATCH REPORT")
    print("=" * 35)
    print(f"Resume skills found : {len(resume_skills)}")
    print(f"Job skills required : {len(job_skills)}")
    print(f"Skill match score   : {score:.1f}%")

    print("\nMatching Skills:")
    if matching:
        for skill in sorted(matching):
            print("  [+]", skill)
    else:
        print("  No matching skills found.")

    print("\nMissing Skills:")
    if missing:
        for skill in sorted(missing):
            print("  [-]", skill)
    else:
        print("  No missing supported skills.")

    print("\nRecommendation:")
    if score >= 75:
        print("Good keyword match! Review the job requirements.")
    elif score >= 40:
        print("Moderate match. Practise the missing skills.")
    else:
        print("Build relevant skills for this job role.")

    print("\nNote: This is keyword-based matching,")
    print("not a trained AI model or hiring prediction.")


if __name__ == "__main__":
    analyze_resume()
